# Скопируйте в deploy/.env и заполните.
# Этот файл использует docker compose: значения попадают в контейнер сайта.

# Домен, на который указывает A-запись (без https://).
DOMAIN=overlay.example.com

# Внешний адрес сайта — он попадёт в ссылку для OBS.
# Должен совпадать с https:// + DOMAIN.
PUBLIC_URL=https://overlay.example.com

# Логин и пароль первого администратора.
# Создаются только при пустой базе (первый запуск). Пароль — минимум 8 символов.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=замените-на-надёжный-пароль

# Секрет подписи токенов. Сгенерируйте: openssl rand -hex 32
# Если не задать, сервер создаст data/secret.key внутри тома.
# JWT_SECRET=

# Необязательно. По умолчанию сервер пишет логи в stdout (docker compose logs).
# HOST=0.0.0.0
# PORT=3000

# Голоса DonationAlerts в панели (необязательно).
# Yandex SpeechKit: API-ключ и folder_id каталога Yandex Cloud.
# YANDEX_TTS_KEY=AQVN...
# YANDEX_TTS_FOLDER=b1g...
# SteosVoice: токен из https://console.cybervoice.io/user
# STEOSVOICE_TOKEN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# STEOSVOICE_API_URL=https://api.steosvoice.ru/v1
