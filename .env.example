# Скопируйте файл в .env и при необходимости измените значения.
# Все переменные необязательны.
#
# Для размещения на хосте (сайт + оверлей без Windows-программы)
# используйте готовые файлы в папке deploy/ — см. deploy/README.md.

# Порт и адрес, на которых слушает сервер
#PORT=3000
#HOST=0.0.0.0

# Внешний адрес сервера (за HTTPS/reverse-proxy).
# Именно он попадёт в ссылку для OBS. Указывайте корень домена без пути.
#PUBLIC_URL=https://overlay.example.com

# Сколько прокси доверять для определения IP и https.
# loopback — когда nginx/Caddy на том же хосте; 1 — когда прокси в Docker.
#TRUST_PROXY=loopback

# Папки с данными и статикой
#DATA_DIR=./data
#PUBLIC_DIR=./public

# Секрет для подписи токенов. Если не задан, создаётся в data/secret.key.
#JWT_SECRET=длинная-случайная-строка

# Первый администратор. Создаётся только когда база пользователей пуста.
#ADMIN_LOGIN=admin
#ADMIN_PASSWORD=замените-на-надёжный-пароль

# Голоса DonationAlerts в панели (необязательно).
# Yandex SpeechKit: API-ключ и folder_id каталога Yandex Cloud.
#YANDEX_TTS_KEY=AQVN...
#YANDEX_TTS_FOLDER=b1g...
# SteosVoice: токен из https://console.cybervoice.io/user
#STEOSVOICE_TOKEN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# Базовый URL API SteosVoice, если провайдер сменит адрес.
#STEOSVOICE_API_URL=https://api.voice.steos.io/v1
